server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __SERVER_NAME__ _;
    root /var/www/home;
    index index.html;
    ssi on;
    add_header Cache-Control "no-cache";

    location /api/ {
        proxy_pass http://127.0.0.1:8099;
        client_max_body_size 2m;
    }
    # uploaded icons: never let an uploaded SVG run scripts
    location /icons/ {
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox";
        add_header X-Content-Type-Options nosniff;
        add_header Cache-Control "public, max-age=86400";
    }
    location = /status.json { add_header Cache-Control "no-store"; }
    location = /apps.json   { add_header Cache-Control "no-store"; }
}
